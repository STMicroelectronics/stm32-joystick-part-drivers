{{!---------------------- Part WEAK FUNC -----------------------------------------------------}}
{{#if (eq @root.IsADCioUsed true)}}
/**
  * @brief initialize the IO layer.
  * @param  pobj   : Joystick object
  * @retval error status.
  */
int32_t joy_adc_io_init(joy_adc_t *pobj)
{
  /* Part Status */
  int ret = 0;

  switch (pobj->id)
  {
{{#each @root.joy_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#with @root.ctx}}
    case JOYSTICK_ADC_{{@index}}:
      pobj->phadc              = JOYSTICK_ADC_{{@index}}_ADC_GETHANDLE();
      pobj->key_up_max_val     = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_UP_VAL + JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_UP_VAL));
      pobj->key_up_min_val     = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_UP_VAL - JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_UP_VAL));
      pobj->key_down_max_val   = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_DOWN_VAL + JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_DOWN_VAL));
      pobj->key_down_min_val   = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_DOWN_VAL - JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_DOWN_VAL));
      pobj->key_left_max_val   = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_LEFT_VAL + JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_LEFT_VAL));
      pobj->key_left_min_val   = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_LEFT_VAL - JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_LEFT_VAL));
      pobj->key_right_max_val  = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_RIGHT_VAL + JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_RIGHT_VAL));
      pobj->key_right_min_val  = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_RIGHT_VAL - JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_RIGHT_VAL));
      pobj->key_center_max_val = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_CENTER_VAL + JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_CENTER_VAL));
      pobj->key_center_min_val = (int32_t)(JOYSTICK_ADC_{{@index}}_KEY_CENTER_VAL - JOYSTICK_ADC_{{@index}}_KEY_TOLERANCE(JOYSTICK_ADC_{{@index}}_KEY_CENTER_VAL));
      break;

{{/with}} {{!-- @root.ctx --}}
{{/each}} {{!-- @root.joy_instances --}}
    default:
      /* Error -- Unknown ID */
      ret = -1;
      break;
  }

  return ret;
}
{{/if}}

