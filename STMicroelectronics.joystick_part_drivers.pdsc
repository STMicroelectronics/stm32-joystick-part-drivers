<?xml version="1.0" encoding="utf-8"?>
<package xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd">
  <vendor>STMicroelectronics</vendor>
  <name>joystick_part_drivers</name>
  <description>Joystick Part Drivers SW Pack</description>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <repository type="git">https://github.com/STMicroelectronics/stm32-joystick-part-drivers</repository>
  <supportContact/>
  <license>LICENSE.md</license>
  <environments>
    <environment name="STM32Cube">
      <stm32:pack type="PARTDRV" friendlyName="joystick" shortDesc="joystick part driver">
        <relocation-info parent="part_drivers" layer="" element=""/>
        <compatibility>
          <release version="2.0.0">
            <applicable-schema schemaType="sw-configuration" schemaVersion="3.8.0"/>
            <applicable-api-group apiType="codegen-getters">
              <applicable-api apiType="SWConfigurationAPI" apiVersion="1.0.0" />
            </applicable-api-group>
          </release>
        </compatibility>
      </stm32:pack>
    </environment>
  </environments>
  <ECCN>
    <ECCN-EU>NEC</ECCN-EU>
    <ECCN-US>EAR99</ECCN-US>
  </ECCN>
  <changelogs>
    <changelog id="Release Notes" name="Release_Notes.html"/>
  </changelogs>
  <releases>
    <release version="2.0.0" date="2026-08-25">
      Refer to Release_Notes.md for release details.
    </release>
  </releases>
  <keywords>
    <keyword>STMicroelectronics</keyword>
    <keyword>ST</keyword>
    <keyword>STM32</keyword>
    <keyword>BSP</keyword>
    <keyword>Parts</keyword>
    <keyword>Drivers</keyword>
    <keyword>joystick</keyword>
    <keyword>ADC</keyword>
  </keywords>
  <conditions>
    <condition id="IO ADC">
      <description>STMicroelectronics ADC interface</description>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="ADC"/>
    </condition>
    <condition id="JOYSTICK CFG Condition">

    </condition>
  </conditions>
  <components>
    <component Cvendor="STMicroelectronics" Cclass="Board Part" Cgroup="Joystick" Csub="ADC" Cversion="1.0.0" condition="IO ADC">
      <description>Driver for joystick driven by ADC based on STM32 HAL</description>
      <files>
        <file category="doc" name="README.md"/>
        <file category="doc" name="SW_Security_Level.md"/>
        <file category="doc" name="doc/st_logo.png"/>
        <file category="doc" name="doc/generic_hardware_setup.png"/>
        <file category="header" name="adc/joystick_adc.h"/>
        <file category="source" name="adc/joystick_adc.c"/>
      </files>
    </component>
    <component generator="joystick_mx2codegen" Cclass="Board Part" Cgroup="STM32CubeMX2 Config" Csub="JOYSTICK" Cversion="1.0.0" condition="JOYSTICK CFG Condition" maxInstances="10">
      <description>joystick STM32CubeMX2 Config</description>
      <environments>
        <environment name="STM32Cube">
          <component>
            <supported-part-types>
              <supported-part-type Hclass="Input Devices" Hgroup="Joystick"/>
            </supported-part-types>
          </component>
        </environment>
      </environments>
      <files>
        <file category="genAsset" name=".config/gen_code.bat"/>
        <file category="genAsset" name=".config/gen_code.sh"/>
        <file category="genAsset" name=".config/STMicroelectronics.joystick_part_drivers.gpdsc.hbs"/>
        <file category="genAsset" name=".config/mx_joystick_parameters.json"/>
        <file category="genAsset" name=".config/template/helpers/adc_helpers.js"/>
        <file category="genAsset" name=".config/template/mx_joystick_template.h.hbs"/>
        <file category="genAsset" name=".config/template/mx_joystick_template.c.hbs"/>
        <file category="genAsset" name=".config/template/mx_joystick_license_template.md.hbs"/>
      </files>
    </component>
  </components>
  <generators>
    <generator id="joystick_mx2codegen">
      <description>ST Microelectronics: STM32 Cube Code Generator for joystick Drivers Pack</description>
      <exe>
        <command host="win">.config/gen_code.bat</command>
        <command host="linux">.config/gen_code.sh</command>
        <command host="mac">.config/gen_code.sh</command>
        <argument>joystick_mx2codegen</argument>
        <argument>$G</argument>
        <argument>STMicroelectronics.joystick_part_drivers.gpdsc.hbs</argument>
        <argument mode="dry-run">--dry-run</argument>
      </exe>
      <gpdsc name="$P/STMicroelectronics.joystick_part_drivers.gpdsc"/>
    </generator>
  </generators>
</package>
